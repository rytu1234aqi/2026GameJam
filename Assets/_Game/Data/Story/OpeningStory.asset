  - Illustration: {fileID: 21300000, guid: 34a149dcf42a99a41bf38d85f05b295c, type: 3}
    Title: "\u6700\u540E\u7684\u5B88\u62A4"
    Body: "\u9879\u94FE\u9707\u9000\u9B54\u7269\uFF0C\u5C06\u54E5\u54E5\u7684\u795E\u9B42\u6536\u5165\u5D4C\u77F3\u3002\u4F46\u8FD9\u6B21\u5B88\u62A4\uFF0C\u4E5F\u8017\u5C3D\u4E86\u5B83\u7684\u529B\u91CF\u3002"
    FadeSeconds: 0.65
    CharactersPerSecond: 26
    HoldSeconds: 2
    MotionSeconds: 8
    ZoomStart: 1
    ZoomEnd: 1.06
    PanStart: {x: -0.015, y: 0}
